# CATATAN: saat ini frontend berjalan di MODE DEMO (data di browser), jadi file .env belum diperlukan.
# Variabel di bawah baru dipakai setelah backend tersambung.

# Salin file ini menjadi .env di folder frontend, lalu sesuaikan. Restart `npm run dev` setelah mengubahnya.

# Alamat dasar (base URL) API backend.
# - Dikosongkan  : memakai '/api' dan Vite meneruskannya ke VITE_PROXY_TARGET (cara paling mudah saat pengembangan).
# - Diisi alamat : frontend memanggil backend langsung, mis. http://localhost:3000/api
#                  Alamat frontend (mis. http://localhost:5173) harus ada di CORS_ORIGIN pada backend/.env.
VITE_API_BASE_URL=http://localhost:3000/api

# Tujuan proxy saat VITE_API_BASE_URL kosong
# VITE_PROXY_TARGET=http://localhost:3000
